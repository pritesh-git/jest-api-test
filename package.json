{
  "name": "jest-api-test",
  "version": "1.0.0",
  "description": "Enterprise-ready REST API automated testing framework using Jest, TypeScript, and Axios",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist coverage",
    "test": "cross-env USE_MOCK=true jest --config jest.config.ts",
    "test:live": "cross-env USE_MOCK=false jest --config jest.config.ts --runInBand",
    "test:watch": "cross-env USE_MOCK=true jest --config jest.config.ts --watch",
    "test:coverage": "cross-env USE_MOCK=true jest --config jest.config.ts --coverage",
    "test:ci": "cross-env USE_MOCK=true jest --config jest.config.ts --ci --coverage --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"*.{json,ts,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"*.{json,ts,md}\""
  },
  "keywords": [
    "jest",
    "typescript",
    "api-testing",
    "automation",
    "axios",
    "reqres",
    "test-automation",
    "rest-api"
  ],
  "author": "Pritesh",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "chance": "^1.1.13",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/chance": "^1.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
